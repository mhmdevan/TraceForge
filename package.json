{
  "name": "traceforge",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.26.1",
  "scripts": {
    "build": "pnpm -r --sort build",
    "dev": "pnpm --parallel --filter './apps/*' start:dev",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "baseline:run": "tsx scripts/run-baseline.ts",
    "metrics:run": "OBS_MODE=metrics EXPERIMENT_ID=metrics-only EXPERIMENT_SMOKE_COMMAND=smoke:metrics EXPERIMENT_BASELINE_CSV=results/processed/baseline-summary.csv tsx scripts/run-baseline.ts",
    "metrics-logs:run": "OBS_MODE=metrics_logs EXPERIMENT_ID=metrics-logs EXPERIMENT_SMOKE_COMMAND=smoke:metrics-logs EXPERIMENT_BASELINE_CSV=results/processed/metrics-only-summary.csv EXPERIMENT_BASELINE_LABEL=\"Metrics Only\" tsx scripts/run-baseline.ts",
    "metrics-logs-traces:run": "OBS_MODE=metrics_logs_traces EXPERIMENT_ID=metrics-logs-traces EXPERIMENT_SMOKE_COMMAND=smoke:metrics-logs-traces EXPERIMENT_BASELINE_CSV=results/processed/metrics-logs-summary.csv EXPERIMENT_BASELINE_LABEL=\"Metrics + Logs\" tsx scripts/run-baseline.ts",
    "otel-full:run": "OBS_MODE=otel_full EXPERIMENT_ID=otel-full EXPERIMENT_SMOKE_COMMAND=smoke:otel-full EXPERIMENT_BASELINE_CSV=results/processed/metrics-logs-traces-summary.csv EXPERIMENT_BASELINE_LABEL=\"Metrics + Logs + Traces\" tsx scripts/run-baseline.ts",
    "overhead:report": "tsx scripts/aggregate-overhead.ts",
    "stats:report": "tsx scripts/statistics-report.ts",
    "load:run": "tsx scripts/run-load-experiment.ts",
    "mttd:run": "tsx scripts/run-mttd.ts",
    "sweep:run": "tsx scripts/run-load-sweep.ts",
    "env:capture": "tsx scripts/capture-environment.ts",
    "failure:report": "tsx scripts/failure-injection-report.ts",
    "indexing:run": "tsx scripts/run-postgres-indexing.ts",
    "indexing:mongo": "tsx scripts/run-mongo-indexing.ts",
    "sql-nosql:report": "tsx scripts/sql-nosql-comparison.ts",
    "orchestration:run": "tsx scripts/run-orchestration.ts",
    "migrate:postgres": "tsx scripts/migrate-postgres.ts",
    "seed:postgres": "tsx scripts/seed-postgres.ts",
    "smoke:baseline": "tsx scripts/smoke-baseline.ts",
    "smoke:metrics": "tsx scripts/smoke-metrics.ts",
    "smoke:metrics-logs": "tsx scripts/smoke-metrics-logs.ts",
    "smoke:metrics-logs-traces": "tsx scripts/smoke-metrics-logs-traces.ts",
    "smoke:otel-full": "tsx scripts/smoke-otel-full.ts",
    "test": "vitest run",
    "test:e2e": "RUN_E2E=true vitest run --config vitest.e2e.config.ts",
    "typecheck": "pnpm --filter './packages/*' --sort build && pnpm -r --sort typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@types/amqplib": "^0.10.7",
    "@types/node": "^22.15.29",
    "@types/pg": "^8.11.14",
    "eslint": "^9.28.0",
    "mongodb": "^6.12.0",
    "globals": "^16.2.0",
    "prettier": "^3.5.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.0",
    "vitest": "^3.1.4"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.2",
    "@nestjs/core": "^11.1.2",
    "@nestjs/platform-express": "^11.1.2",
    "amqplib": "^0.10.8",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "redis": "^5.8.3",
    "rxjs": "^7.8.2"
  }
}
